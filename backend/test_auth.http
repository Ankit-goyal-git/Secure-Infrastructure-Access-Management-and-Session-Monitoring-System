### 1. Authenticate / Login User (Employee)
# This will return a JSON object containing your "token". Copy that token.
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "rahul@example.com",
  "password": "password123"
}

### 2. Fetch User Profile
# Replace the token string below with the actual token you copied from Step 1.
GET http://localhost:3000/api/auth/me
Authorization: Bearer REPLACE_WITH_JWT_TOKEN_FROM_STEP_1


### ==========================================
### BLOCK 3: ACCESS REQUESTS & SERVERS (Employee)
### ==========================================

### 3. Fetch Target Servers List
GET http://localhost:3000/api/servers
Authorization: Bearer REPLACE_WITH_JWT_TOKEN_FROM_STEP_1

### 4. Create Access Request (Fails if duplicate pending/active exists)
POST http://localhost:3000/api/access-requests
Authorization: Bearer REPLACE_WITH_JWT_TOKEN_FROM_STEP_1
Content-Type: application/json

{
  "serverId": 1,
  "duration": 30,
  "reason": "Debug deployment issue"
}

### 5. Fetch Personal Access Request Logs History
GET http://localhost:3000/api/access-requests
Authorization: Bearer REPLACE_WITH_JWT_TOKEN_FROM_STEP_1


### ==========================================
### BLOCK 4: MANAGER PORTAL & APPROVALS (Manager)
### ==========================================

### 6. Authenticate / Login Manager
# Returns a token for Manager role (Boss Bob)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "boss@example.com",
  "password": "password123"
}

### 7. Fetch Pending Requests List (Manager Auth Required)
GET http://localhost:3000/api/manager/access-requests
Authorization: Bearer REPLACE_WITH_MANAGER_TOKEN_FROM_STEP_6

### 8. Approve Access Request (Mandatory duration and approvalReason notes)
# Fails if manager tries to self-approve or grant duration exceeding the request limits
POST http://localhost:3000/api/manager/access-requests/1/approve
Authorization: Bearer REPLACE_WITH_MANAGER_TOKEN_FROM_STEP_6
Content-Type: application/json

{
  "duration": 30,
  "approvalReason": "Approve access to execute PostgreSQL schema patches under ticket #8291"
}

### 9. Deny Access Request (Replace :id with request ID from Step 7)
POST http://localhost:3000/api/manager/access-requests/2/deny
Authorization: Bearer REPLACE_WITH_MANAGER_TOKEN_FROM_STEP_6
Content-Type: application/json

{
  "reason": "Request lacks valid business context"
}

### 10. Immediate Revocation of Active Access Grant (Manager)
# Evicts Redis authorization key and terminates any running active gateway sessions
POST http://localhost:3000/api/manager/access-grants/1/revoke
Authorization: Bearer REPLACE_WITH_MANAGER_TOKEN_FROM_STEP_6


### ==========================================
### BLOCK 5: INTERNAL GATEWAY APIS (SSH Gateway)
### ==========================================

### 11. Check Authorization Status (Gateway)
# Returns allowed=true, targetHost, targetPort and expiresAt
GET http://localhost:3000/internal/access/check?userId=1&serverId=1
x-api-key: gateway_secret_key_5678

### 12. Start SSH Session Webhook
POST http://localhost:3000/internal/sessions/start
x-api-key: gateway_secret_key_5678
Content-Type: application/json

{
  "sessionId": "0f0f9a1c-1234-4567-8901-123456789abc",
  "userId": 1,
  "serverId": 1
}

### 13. Forward Command Audit Event Webhook
POST http://localhost:3000/internal/audit/events
x-api-key: gateway_secret_key_5678
Content-Type: application/json

{
  "sessionId": "0f0f9a1c-1234-4567-8901-123456789abc",
  "userId": 1,
  "serverId": 1,
  "eventType": "COMMAND_EXECUTED",
  "eventData": {
    "command": "ls -la"
  }
}

### 14. Forward Policy Violation / Security Alert (Returns terminateSession instruction)
POST http://localhost:3000/internal/security-events
x-api-key: gateway_secret_key_5678
Content-Type: application/json

{
  "sessionId": "0f0f9a1c-1234-4567-8901-123456789abc",
  "userId": 1,
  "serverId": 1,
  "rule": "SENSITIVE_FILE_ACCESS",
  "severity": "high",
  "description": "User attempted to run: cat /etc/shadow"
}

### 15. End SSH Session Webhook (Wipes Redis grant if reason is access_expired)
POST http://localhost:3000/internal/sessions/end
x-api-key: gateway_secret_key_5678
Content-Type: application/json

{
  "sessionId": "0f0f9a1c-1234-4567-8901-123456789abc",
  "reason": "user_disconnect"
}


### ==========================================
### ADMIN SERVER ONBOARDING APIS (Admin Only)
### ==========================================

### 16. Authenticate / Login Admin
# Returns a token for Admin role (Alice)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123"
}

### 17. Onboard New Server Node (Admin Required)
# Fails if server host/port already exists
POST http://localhost:3000/api/servers
Authorization: Bearer REPLACE_WITH_ADMIN_TOKEN_FROM_STEP_16
Content-Type: application/json

{
  "name": "staging-k8s-node-0",
  "host": "192.168.1.50",
  "port": 22,
  "description": "Staging Kubernetes Master Node"
}

### 18. Update Server Node Configuration/Status (Admin Required)
# Allows changing host, port, description or status (active, inactive, maintenance)
PUT http://localhost:3000/api/servers/1
Authorization: Bearer REPLACE_WITH_ADMIN_TOKEN_FROM_STEP_16
Content-Type: application/json

{
  "status": "maintenance",
  "description": "Temporarily disabled for server OS upgrades"
}
