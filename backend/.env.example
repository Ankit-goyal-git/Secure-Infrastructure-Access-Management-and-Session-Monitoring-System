# Backend Service Environment Variables (.env.example)
PORT=3000
NODE_ENV=production

# PostgreSQL Connection String
DATABASE_URL=postgres://secure_gateway_user:change_me@localhost:5433/secure_gateway

# Redis Connection String (used for session caching and active revocation broadcasts)
REDIS_URL=redis://localhost:6379

# Cryptographic Secrets
JWT_SECRET=generate_high_entropy_jwt_secret_key_production_32chars
GATEWAY_API_KEY=generate_high_entropy_gateway_internal_secret_5678
CREDENTIAL_ENCRYPTION_KEY=super_secure_vault_master_key_2026_aes256_32b

