# ==============================================================================
# SECURE INFRASTRUCTURE ACCESS MANAGEMENT - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================
# This is the master production-ready template. 
# Copy this file to '.env' and substitute secrets before launching in production.
# NEVER commit your actual '.env' containing production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection credentials and database naming.
POSTGRES_DB=secure_gateway
POSTGRES_USER=secure_gateway_user
# IMPORTANT: In production, generate a cryptographically strong 32+ character password.
POSTGRES_PASSWORD=change_me_to_a_secure_password_in_production
POSTGRES_PORT=5433

# Full PostgreSQL Connection URI
# Local dev: postgres://secure_gateway_user:change_me@localhost:5433/secure_gateway
# Docker Compose: postgres://secure_gateway_user:change_me@postgres:5432/secure_gateway
DATABASE_URL=postgres://secure_gateway_user:change_me_to_a_secure_password_in_production@localhost:5433/secure_gateway

# ------------------------------------------------------------------------------
# 2. CACHE & PUB/SUB CONFIGURATION (Redis)
# ------------------------------------------------------------------------------
# Redis instance used for revocation pub/sub, rate limiting, and OTP states.
REDIS_HOST=localhost
REDIS_PORT=6379
# Local dev: redis://localhost:6379
# Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. BACKEND API SERVICE (Node.js / Express - Port 3000)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# JWT Authentication Secret Key (Generate with: openssl rand -base64 32)
JWT_SECRET=generate_high_entropy_jwt_secret_key_production_32chars

# Shared Internal Gateway API Key (Used to authenticate SSH Gateway -> Backend webhooks)
GATEWAY_API_KEY=generate_high_entropy_gateway_internal_secret_5678

# AES-256 Master Encryption Key for Stored Target Node Credentials
CREDENTIAL_ENCRYPTION_KEY=super_secure_vault_master_key_2026_aes256_32b

# ------------------------------------------------------------------------------
# 4. SSH BASTION GATEWAY (Python / AsyncSSH - Port 2222)
# ------------------------------------------------------------------------------
BACKEND_URL=http://localhost:3000
SSH_HOST=0.0.0.0
SSH_PORT=2222
METRICS_HOST=0.0.0.0
METRICS_PORT=8000
RECORDINGS_DIR=../recordings

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT (React / Vite - Port 5173)
# ------------------------------------------------------------------------------
# Base URL pointing to the Backend REST API
VITE_API_URL=http://localhost:3000/api

# Enable 1-Click Demo Switcher on Login Page (false for production; true for internal dev testing)
VITE_ENABLE_DEMO_LOGIN=false

# ------------------------------------------------------------------------------
# 6. MONITORING & OBSERVABILITY (Prometheus & Grafana)
# ------------------------------------------------------------------------------
MONITORING_PORT=3001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# Grafana Admin Credentials
# WARNING: Change default password in production
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_grafana_master_password_in_production

# Anomaly Detection & Security Alert Thresholds
ALERT_FAILURE_THRESHOLD=5
ALERT_FAILURE_WINDOW_SECONDS=300
ALERT_BLOCK_THRESHOLD=3
ALERT_BLOCK_WINDOW_SECONDS=300
ALERT_COOLDOWN_SECONDS=60
