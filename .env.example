# =========================================================================
# Secure Infrastructure Access Management and Session Monitoring System
# Environment Configurations Template (.env.example)
# Copy this file as '.env' and modify the values locally. Do NOT commit '.env'.
# =========================================================================

# Database Storage Settings (PostgreSQL)
POSTGRES_DB=secure_gateway
POSTGRES_USER=secure_gateway_user
# WARNING: Change this password in production
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://secure_gateway_user:change_me@db:5432/secure_gateway

# Cache Storage Settings (Redis)
REDIS_URL=redis://redis:6379/0

# Monitoring API Settings
MONITORING_PORT=3001

# Security Alert Threshold Rules
ALERT_FAILURE_THRESHOLD=5
ALERT_FAILURE_WINDOW_SECONDS=300
ALERT_BLOCK_THRESHOLD=3
ALERT_BLOCK_WINDOW_SECONDS=300
ALERT_COOLDOWN_SECONDS=60

# Visualization Settings (Grafana)
# WARNING: Change this password in production
GRAFANA_ADMIN_PASSWORD=admin
